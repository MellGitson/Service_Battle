# Dockerfile.vm : la machine cible vm-prod.
# Un conteneur qui joue le role du serveur de production : SSH + son propre Docker,
# capable de recevoir "docker compose pull && docker compose up -d" depuis la pipeline.
FROM docker:27-dind

RUN apk add --no-cache openssh-server bash

RUN ssh-keygen -A \
    && mkdir -p /root/.ssh \
    && chmod 700 /root/.ssh

# La cle publique de deploiement est fournie au build (voir infra/deploy_key.pub),
# jamais la cle privee : c'est elle qui autorise la pipeline a se connecter en SSH.
ARG DEPLOY_PUBLIC_KEY_FILE=deploy_key.pub
COPY ${DEPLOY_PUBLIC_KEY_FILE} /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys

RUN sed -i \
    -e 's/#Port 22/Port 22/' \
    -e 's/#PermitRootLogin.*/PermitRootLogin prohibit-password/' \
    -e 's/#PasswordAuthentication.*/PasswordAuthentication no/' \
    /etc/ssh/sshd_config

COPY entrypoint.vm.sh /entrypoint.vm.sh
RUN chmod +x /entrypoint.vm.sh

EXPOSE 22 3000 3001 9090

ENTRYPOINT ["/entrypoint.vm.sh"]
