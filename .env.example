# Copier en .env et remplir. Ne jamais committer le .env reel.

# Registry d'images (ex: ghcr.io/<org>)
REGISTRY=

# Identifiant de l'equipage affiche sur le tableau
GROUPE=

# Couleur des carres de l'equipage sur le tableau (hex)
COULEUR=#888888

# Tag d'image a deployer (sha du commit en pipeline)
TAG=dev

# URL du tableau de bord (pouls)
TABLEAU_URL=

# Mot de passe de la base Postgres
DB_PASSWORD=

# Nom de la base et utilisateur Postgres
DB_NAME=flotte
DB_USER=flotte

# Emplacement du fichier de pavillon (persistant via volume)
PAVILLON_FICHIER=/data/pavillon.txt

# Mot de passe admin Grafana
GRAFANA_ADMIN_PASSWORD=

